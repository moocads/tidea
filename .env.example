# Copy to .env.local:  cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables (same keys)

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# GA4 — leave as placeholder until production
NEXT_PUBLIC_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# ── Cloudflare Forms Worker (public frontend configuration) ──
# Production: set both values in Vercel Project → Settings → Environment Variables.
NEXT_PUBLIC_FORMS_API_URL=https://tidea-forms-worker.<account-subdomain>.workers.dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
